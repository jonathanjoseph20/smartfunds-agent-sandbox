{
  "version": 1,
  "profiles": {
    "lite": {
      "mutationAllowed": false
    },
    "build": {
      "allowedRepos": ["smartfunds-agent-sandbox"],
      "allowedPaths": {
        "smartfunds-agent-sandbox": [
          "apps/**",
          "dashboard/**",
          "docs/**"
        ]
      }
    },
    "core": {
      "allowedRepos": ["smartfunds-agent-sandbox"],
      "allowedPaths": {
        "smartfunds-agent-sandbox": [
          ".github/workflows/**",
          "control-plane/**",
          "entities/**",
          "governance/**",
          "packages/**",
          "runtime/**",
          "scripts/**"
        ]
      },
      "coreOnlyRepos": ["smartfunds-agent-sandbox"],
      "coreOnlyPaths": {
        "smartfunds-agent-sandbox": [
          ".github/workflows/**",
          "control-plane/**",
          "entities/**",
          "governance/**",
          "packages/**",
          "runtime/**",
          "scripts/**"
        ]
      }
    }
  }
}
